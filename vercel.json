{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "regions": [
    "sin1"
  ],

  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.6.2"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "data/*.json",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api.php",
      "dest": "/api.php"
    },
    {
      "src": "/test-api",
      "dest": "/test-api.html"
    },
    {
      "src": "/(.*\\.(?:js|css|json|html|ico|png|jpg))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}